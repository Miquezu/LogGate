<Window
    x:Class="LogGate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LogGate.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LogGate"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Учет времени — Сводка"
    Width="1200"
    Height="600"
    Background="#F5F6F8"
    Closed="Window_Closed"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:AnomalyColorConverter x:Key="AnomalyColorConverter" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,0,0,10"
            Padding="12,8"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <!--  Отступ между уровнями  -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  1 УРОВЕНЬ: Поиск и Глобальные функции  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        Grid.Column="0"
                        MaxWidth="400"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Hint="Поиск по ФИО, пропуску..."
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding GenerateAiReportCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="Brain" />
                                <TextBlock VerticalAlignment="Center" Text="Анализ ИИ" />
                            </StackPanel>
                        </Button>

                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding OpenScheduleSettingsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="ChartBox" />
                                <TextBlock VerticalAlignment="Center" Text="Расписание" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding LoadDataCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="FileUpload" />
                                <TextBlock VerticalAlignment="Center" Text="Загрузить CSV" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  2 УРОВЕНЬ: Фильтры  -->
                <StackPanel
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ComboBox
                        Width="140"
                        Margin="0,0,15,0"
                        materialDesign:HintAssist.Hint="Период"
                        ItemsSource="{Binding DatePresets}"
                        SelectedItem="{Binding SelectedDatePreset}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <DatePicker
                        Width="130"
                        Margin="0,0,10,0"
                        materialDesign:HintAssist.Hint="С даты"
                        SelectedDate="{Binding StartDate}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                    <DatePicker
                        Width="130"
                        Margin="0,0,20,0"
                        materialDesign:HintAssist.Hint="По дату"
                        SelectedDate="{Binding EndDate}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                    <CheckBox
                        Margin="0,0,10,0"
                        Content="Опоздавшие"
                        IsChecked="{Binding ShowLateArrivals}"
                        Style="{StaticResource MaterialDesignFilterChipOutlineCheckBox}"
                        ToolTip="Показать только опоздавших сотрудников" />

                    <CheckBox
                        Margin="0,0,10,0"
                        Content="Ушли рано"
                        IsChecked="{Binding ShowEarlyDepartures}"
                        Style="{StaticResource MaterialDesignFilterChipOutlineCheckBox}"
                        ToolTip="Показать тех, кто ушел раньше времени" />

                    <CheckBox
                        Margin="0,0,20,0"
                        Content="Не пройден алкотест"
                        IsChecked="{Binding ShowMissingAlcotest}"
                        Style="{StaticResource MaterialDesignFilterChipOutlineCheckBox}"
                        ToolTip="Показать тех, Кто не прошел алкотест" />

                    <Button Command="{Binding ResetFiltersCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="FilterRemove" />
                            <TextBlock VerticalAlignment="Center" Text="Сброс" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid
            x:Name="LogsDataGrid"
            Grid.Row="1"
            AlternatingRowBackground="#FFF0F0F0"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            HeadersVisibility="All"
            IsReadOnly="False"
            ItemsSource="{Binding DataItems}"
            RowHeight="33"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            Sorting="LogsDataGrid_Sorting"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            ScrollViewer.CanContentScroll="True">

            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding Converter={StaticResource AnomalyColorConverter}}" />
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.InputBindings>
                <MouseBinding Command="{Binding OpenEmployeeCardCommand}" Gesture="LeftDoubleClick" />
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EventTime, StringFormat=\{0:dd.MM.yy\}}"
                    Header="Дата"
                    IsReadOnly="True"
                    SortMemberPath="EventTime" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EventTime, StringFormat=\{0:HH:mm:ss\}}"
                    Header="Время"
                    IsReadOnly="True"
                    SortMemberPath="EventTime">
                    <DataGridTextColumn.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="Background" Value="{Binding Converter={StaticResource AnomalyColorConverter}, ConverterParameter=Time}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5,2" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding Direction}"
                    Header="Вх./выход"
                    IsReadOnly="True"
                    SortMemberPath="Direction" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding TemperatureTime, StringFormat=\{0:HH:mm:ss\}}"
                    Header="Время 🌡️"
                    IsReadOnly="True"
                    SortMemberPath="TemperatureTime" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding Temperature}"
                    Header="🌡️ °C"
                    IsReadOnly="True"
                    SortMemberPath="Temperature">
                    <DataGridTextColumn.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="Background" Value="{Binding Converter={StaticResource AnomalyColorConverter}, ConverterParameter=Temp}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding AlcotestTime, StringFormat=\{0:dd.MM.yy HH:mm:ss\}}"
                    Header="Время алко."
                    IsReadOnly="True"
                    SortMemberPath="AlcotestTime" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding AlcotestResult}"
                    Header="Результат алко."
                    IsReadOnly="True"
                    SortMemberPath="AlcotestResult">
                    <DataGridTextColumn.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="Background" Value="{Binding Converter={StaticResource AnomalyColorConverter}, ConverterParameter=Alco}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding FullName}"
                    Header="ФИО"
                    IsReadOnly="True"
                    SortMemberPath="FullName" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Position}"
                    Header="Должность"
                    IsReadOnly="True"
                    SortMemberPath="Position" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Department}"
                    Header="Подразделение"
                    IsReadOnly="True"
                    SortMemberPath="Department" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EmployeeNumber}"
                    Header="Таб. №"
                    IsReadOnly="True"
                    SortMemberPath="EmployeeNumber" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding PassNumber}"
                    Header="Пропуск"
                    IsReadOnly="True"
                    SortMemberPath="PassNumber" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding SystemNote}"
                    Header="Системный статус"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                    Header="Примечание" />
            </DataGrid.Columns>
        </DataGrid>
        <StatusBar
            Grid.Row="2"
            Padding="10,4"
            materialDesign:ElevationAssist.Elevation="Dp1"
            Background="{DynamicResource MaterialDesignPaper}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!--  Левая часть: Статус  -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <!--  Правая часть: Счетчики  -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!--  1. Сообщение о статусе  -->
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Kind="InformationOutline"
                        Opacity="0.7" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.85"
                        Text="{Binding StatusMessage}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Center">
                <Button
                    Command="{Binding SaveChangesCommand}"
                    Content="💾 Сохранить изменения"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!--  Кнопка Назад  -->
                    <Button
                        Width="30"
                        Height="30"
                        Padding="0"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </Button>

                    <!--  Индикатор страниц  -->
                    <TextBlock Margin="15,0" VerticalAlignment="Center">
                        <Run Text="Стр. " />
                        <Run FontWeight="SemiBold" Text="{Binding CurrentPage}" />
                        <Run Text=" из " />
                        <Run Text="{Binding TotalPages}" />
                    </TextBlock>

                    <!--  Кнопка Вперед  -->
                    <Button
                        Width="30"
                        Height="30"
                        Padding="0"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </Button>
                </StackPanel>
            </StatusBarItem>

            <!--  2. Информация о количестве записей  -->
            <StatusBarItem Grid.Column="3">
                <StackPanel Orientation="Horizontal">
                    <!--  Отображается, если применен фильтр  -->
                    <StackPanel Margin="0,0,15,0" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="FilterCheck"
                            Opacity="0.7" />
                        <TextBlock Opacity="0.7" Text="Показано: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FilteredCount}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,15,0"
                        Opacity="0.3"
                        Text="|" />

                    <!--  Всего записей  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Database"
                            Opacity="0.7" />
                        <TextBlock Opacity="0.7" Text="Всего в базе: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding TotalCount}" />
                    </StackPanel>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>