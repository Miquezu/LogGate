<Window
    x:Class="LogGate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LogGate"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Учет времени — Сводка"
    Width="1000"
    Height="600"
    Background="#F5F6F8"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,0,0,10"
            Padding="12,8"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8">

            <WrapPanel VerticalAlignment="Center">
                <Button
                    Margin="0,0,15,0"
                    Command="{Binding LoadDataCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    ToolTip="Загрузить лог-файл CSV"
                    Height="50"
                    >
                    
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="FolderUpload" />
                        <TextBlock VerticalAlignment="Center" Text="Загрузить CSV" />
                    </StackPanel>
                </Button>
                <TextBox
                    Height="50"
                    Width="250"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="Поиск по ФИО, пропуску..."
                    materialDesign:TextFieldAssist.HasClearButton="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <!--  Фильтр по дате "С"  -->
                <DatePicker
                    Height="50"
                    Width="140"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="С даты"
                    SelectedDate="{Binding StartDate}"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                <!--  Фильтр по дате "По"  -->
                <DatePicker
                    Height="50"
                    Width="140"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="По дату"
                    SelectedDate="{Binding EndDate}"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                <!--  Кнопка сброса фильтров  -->
                <Button
                    Height="50"
                    VerticalAlignment="Center"
                    Command="{Binding ResetFiltersCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="Сбросить все фильтры">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="FilterRemove" />
                        <TextBlock VerticalAlignment="Center" Text="Сброс" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </Border>
        <DataGrid
            Grid.Row="1"
            AlternatingRowBackground="#FFF0F0F0"
            AutoGenerateColumns="False"
            HeadersVisibility="All"
            IsReadOnly="True"
            ItemsSource="{Binding DataItems}"
            RowHeight="33">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EventTime, StringFormat=\{0:dd.MM.yy\}}"
                    Header="Дата" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EventTime, StringFormat=\{0:HH:mm:ss\}}"
                    Header="Время" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding Direction}"
                    Header="Вх./выход" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding TemperatureTime, StringFormat=\{0:dd.MM.yy HH:mm:ss\}}"
                    Header="Время 🌡️" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding Temperature}"
                    Header="🌡️ °C" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding AlcotestTime, StringFormat=\{0:dd.MM.yy HH:mm:ss\}}"
                    Header="Время алко." />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding AlcotestResult}"
                    Header="Результат алко." />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding FullName}"
                    Header="ФИО" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Position}"
                    Header="Должность" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Department}"
                    Header="Подразделение" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EmployeeNumber}"
                    Header="Таб. №" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding PassNumber}"
                    Header="Пропуск" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>