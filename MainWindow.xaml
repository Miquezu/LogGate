<Window
    x:Class="LogGate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LogGate.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LogGate"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:LogGate.Views"
    Title="Учет времени — Сводка"
    Width="1200"
    Height="600"
    Background="#F5F6F8"
    Closed="Window_Closed"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:AnomalyColorConverter x:Key="AnomalyColorConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,0,0,10"
            Padding="14,10"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <!--  Отступ между уровнями  -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  1 УРОВЕНЬ: Переключатель экранов, Поиск и Действия  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <!-- Переключатель экранов -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Живой поиск -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Пустое пространство -->
                        <ColumnDefinition Width="*" />
                        <!-- Действия справа -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Переключатель: Журнал / Дашборд (Segmented Pill Switcher) -->
                    <Border
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Padding="3"
                        Background="#F0F2F5"
                        CornerRadius="8"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                GroupName="ViewSwitcher"
                                IsChecked="{Binding IsDashboardView, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                Command="{Binding SwitchToLogsViewCommand}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border
                                            x:Name="TabBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="14,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    x:Name="TabIcon"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="#757575"
                                                    Kind="TableLarge" />
                                                <TextBlock
                                                    x:Name="TabText"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="#757575"
                                                    Text="Журнал" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                                <Setter TargetName="TabBorder" Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
                                                <Setter TargetName="TabIcon" Property="Foreground" Value="#5E35B1" />
                                                <Setter TargetName="TabText" Property="Foreground" Value="#5E35B1" />
                                                <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>

                            <RadioButton
                                GroupName="ViewSwitcher"
                                IsChecked="{Binding IsDashboardView, Mode=TwoWay}"
                                Command="{Binding SwitchToDashboardViewCommand}">
                                <RadioButton.Template>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border
                                            x:Name="TabBorder"
                                            Background="Transparent"
                                            CornerRadius="6"
                                            Padding="14,6">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    x:Name="TabIcon"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="#757575"
                                                    Kind="ViewDashboardOutline" />
                                                <TextBlock
                                                    x:Name="TabText"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Medium"
                                                    Foreground="#757575"
                                                    Text="Дашборд" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="TabBorder" Property="Background" Value="White" />
                                                <Setter TargetName="TabBorder" Property="materialDesign:ElevationAssist.Elevation" Value="Dp1" />
                                                <Setter TargetName="TabIcon" Property="Foreground" Value="#5E35B1" />
                                                <Setter TargetName="TabText" Property="Foreground" Value="#5E35B1" />
                                                <Setter TargetName="TabText" Property="FontWeight" Value="SemiBold" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </RadioButton.Template>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Поле поиска (скрывается на дашборде) -->
                    <TextBox
                        Grid.Column="1"
                        Width="320"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Hint="Поиск по ФИО, отделу, пропуску..."
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        FontSize="12"
                        Padding="8,7"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{Binding IsDashboardView, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Группа действий справа -->
                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Height="36"
                            Command="{Binding GenerateAiReportCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#7E57C2"
                            Foreground="#5E35B1"
                            ToolTip="Открыть диалог с AI-Аналитиком логов">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#7E57C2"
                                    Kind="AutoAwesome" />
                                <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="Анализ ИИ" />
                            </StackPanel>
                        </Button>

                        <Button
                            Margin="0,0,10,0"
                            Height="36"
                            Command="{Binding OpenScheduleSettingsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="Настройки графиков работы отделов и сотрудников">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#5E35B1"
                                    Kind="CalendarClock" />
                                <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="Графики" />
                            </StackPanel>
                        </Button>

                        <Button
                            Margin="0,0,10,0"
                            Height="36"
                            Command="{Binding ExportDataCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#5E35B1"
                            Foreground="#5E35B1"
                            ToolTip="Экспортировать текущую выборку в CSV-файл (для Excel)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#5E35B1"
                                    Kind="FileExportOutline" />
                                <TextBlock VerticalAlignment="Center" FontWeight="Medium" Text="Экспорт" />
                            </StackPanel>
                        </Button>

                        <Button
                            Height="36"
                            Command="{Binding LoadDataCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#5E35B1"
                            BorderBrush="#5E35B1"
                            ToolTip="Импортировать CSV-файл">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="FileUploadOutline" />
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Загрузить CSV" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  2 УРОВЕНЬ: Выбор периода + Умные фильтры журнала  -->
                <Grid Grid.Row="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Период и даты -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Разделитель -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Чипы и сброс -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ComboBox
                            Width="140"
                            Margin="0,0,10,0"
                            materialDesign:HintAssist.Hint="Период"
                            ItemsSource="{Binding DatePresets}"
                            SelectedItem="{Binding SelectedDatePreset}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            FontSize="12"
                            Padding="8,6" />

                        <DatePicker
                            Width="125"
                            Margin="0,0,8,0"
                            materialDesign:HintAssist.Hint="С даты"
                            SelectedDate="{Binding StartDate}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            FontSize="12"
                            Padding="6,6" />

                        <DatePicker
                            Width="125"
                            Margin="0,0,10,0"
                            materialDesign:HintAssist.Hint="По дату"
                            SelectedDate="{Binding EndDate}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            FontSize="12"
                            Padding="6,6" />

                        <ComboBox
                            Width="180"
                            materialDesign:HintAssist.Hint="Подразделение"
                            ItemsSource="{Binding Departments}"
                            SelectedItem="{Binding SelectedDepartment}"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            FontSize="12"
                            Padding="8,6" />
                    </StackPanel>

                    <!-- Тонкий разделитель между датами и чипами -->
                    <Border
                        Grid.Column="1"
                        Width="1"
                        Height="24"
                        Margin="14,0"
                        Background="#E0E0E0"
                        Visibility="{Binding IsDashboardView, Converter={StaticResource InverseBoolToVis}}" />

                    <!-- Умные цветные чипы-фильтры (скрываются на дашборде) -->
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding IsDashboardView, Converter={StaticResource InverseBoolToVis}}">

                        <!-- Опоздавшие -->
                        <CheckBox
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            IsChecked="{Binding ShowLateArrivals}">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border
                                        x:Name="ChipBorder"
                                        Background="#FAFAFA"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                x:Name="ChipIcon"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="#757575"
                                                Kind="ClockAlertOutline" />
                                            <TextBlock
                                                x:Name="ChipText"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="#616161"
                                                Text="Опоздавшие" />
                                            <Border
                                                x:Name="CountBadge"
                                                Margin="6,0,0,0"
                                                Padding="5,1"
                                                Background="#EEEEEE"
                                                CornerRadius="6"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="CountText"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="#757575"
                                                    Text="{Binding DataContext.LateCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ChipBorder" Property="Background" Value="#FFF3E0" />
                                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#FFB74D" />
                                            <Setter TargetName="ChipIcon" Property="Foreground" Value="#E65100" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="#E65100" />
                                            <Setter TargetName="ChipText" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="CountBadge" Property="Background" Value="#FFE0B2" />
                                            <Setter TargetName="CountText" Property="Foreground" Value="#BF360C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <!-- Ушли рано -->
                        <CheckBox
                            Margin="0,0,8,0"
                            Cursor="Hand"
                            IsChecked="{Binding ShowEarlyDepartures}">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border
                                        x:Name="ChipBorder"
                                        Background="#FAFAFA"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                x:Name="ChipIcon"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="#757575"
                                                Kind="RunFast" />
                                            <TextBlock
                                                x:Name="ChipText"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="#616161"
                                                Text="Ушли рано" />
                                            <Border
                                                x:Name="CountBadge"
                                                Margin="6,0,0,0"
                                                Padding="5,1"
                                                Background="#EEEEEE"
                                                CornerRadius="6"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="CountText"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="#757575"
                                                    Text="{Binding DataContext.EarlyCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ChipBorder" Property="Background" Value="#FFEBEE" />
                                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#E57373" />
                                            <Setter TargetName="ChipIcon" Property="Foreground" Value="#C62828" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="#C62828" />
                                            <Setter TargetName="ChipText" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="CountBadge" Property="Background" Value="#FFCDD2" />
                                            <Setter TargetName="CountText" Property="Foreground" Value="#B71C1C" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <!-- Не пройден алкотест -->
                        <CheckBox
                            Margin="0,0,12,0"
                            Cursor="Hand"
                            IsChecked="{Binding ShowMissingAlcotest}">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Border
                                        x:Name="ChipBorder"
                                        Background="#FAFAFA"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,5">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                x:Name="ChipIcon"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="#757575"
                                                Kind="AlertOctagonOutline" />
                                            <TextBlock
                                                x:Name="ChipText"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="#616161"
                                                Text="Без алкотеста" />
                                            <Border
                                                x:Name="CountBadge"
                                                Margin="6,0,0,0"
                                                Padding="5,1"
                                                Background="#EEEEEE"
                                                CornerRadius="6"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="CountText"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="#757575"
                                                    Text="{Binding DataContext.MissingAlcotestCount, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ChipBorder" Property="Background" Value="#FCE4EC" />
                                            <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#F06292" />
                                            <Setter TargetName="ChipIcon" Property="Foreground" Value="#AD1457" />
                                            <Setter TargetName="ChipText" Property="Foreground" Value="#AD1457" />
                                            <Setter TargetName="ChipText" Property="FontWeight" Value="SemiBold" />
                                            <Setter TargetName="CountBadge" Property="Background" Value="#F8BBD0" />
                                            <Setter TargetName="CountText" Property="Foreground" Value="#880E4F" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>

                        <!-- Кнопка Сброс -->
                        <Button
                            Command="{Binding ResetFiltersCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Height="32"
                            Padding="8,0"
                            ToolTip="Сбросить все примененные фильтры">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="#757575"
                                    Kind="FilterRemoveOutline" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#757575"
                                    Text="Сброс" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DataGrid
            x:Name="LogsDataGrid"
            Grid.Row="1"
            AlternatingRowBackground="#FAFAFA"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            HeadersVisibility="All"
            IsReadOnly="False"
            ItemsSource="{Binding DataItems}"
            RowHeight="36"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            Sorting="LogsDataGrid_Sorting"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            Visibility="{Binding IsDashboardView, Converter={StaticResource InverseBoolToVis}}">

            <DataGrid.InputBindings>
                <MouseBinding Command="{Binding OpenEmployeeCardCommand}" Gesture="LeftDoubleClick" />
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <!-- Дата -->
                <DataGridTextColumn
                    Width="85"
                    Binding="{Binding EventTime, StringFormat=\{0:dd.MM.yy\}}"
                    Header="Дата"
                    IsReadOnly="True"
                    SortMemberPath="EventTime" />

                <!-- Время (со статусным бейджем опоздания / раннего ухода) -->
                <DataGridTemplateColumn Width="95" Header="Время" SortMemberPath="EventTime">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                <Setter Property="Background" Value="#FFF3E0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEarlyDeparture}" Value="True">
                                                <Setter Property="Background" Value="#FFEBEE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,3,0"
                                        VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Kind" Value="ClockAlertOutline" />
                                                        <Setter Property="Foreground" Value="#E65100" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEarlyDeparture}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Kind" Value="RunFast" />
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding EventTime, StringFormat=\{0:HH:mm:ss\}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#212121" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                        <Setter Property="Foreground" Value="#E65100" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEarlyDeparture}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Вход / Выход (стильный чип с иконкой) -->
                <DataGridTemplateColumn Width="105" Header="Вх./Вых." SortMemberPath="Direction">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#ECEFF1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Direction}" Value="Вход">
                                                <Setter Property="Background" Value="#E8F5E9" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="Выход">
                                                <Setter Property="Background" Value="#EDE7F6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,3,0"
                                        VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="ArrowRight" />
                                                <Setter Property="Foreground" Value="#546E7A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="Вход">
                                                        <Setter Property="Kind" Value="Login" />
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="Выход">
                                                        <Setter Property="Kind" Value="Logout" />
                                                        <Setter Property="Foreground" Value="#5E35B1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Direction}" />
                                                <Setter Property="Foreground" Value="#546E7A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="Вход">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="Выход">
                                                        <Setter Property="Foreground" Value="#5E35B1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Время 🌡️ -->
                <DataGridTextColumn
                    Width="95"
                    Binding="{Binding TemperatureTime, StringFormat=\{0:HH:mm:ss\}}"
                    Header="Время 🌡️"
                    IsReadOnly="True"
                    SortMemberPath="TemperatureTime" />

                <!-- Температура (со статусным бейджем) -->
                <DataGridTemplateColumn Width="85" Header="🌡️ °C" SortMemberPath="Temperature">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFever}" Value="True">
                                                <Setter Property="Background" Value="#FFEBEE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFever}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Kind" Value="ThermometerAlert" />
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding Temperature, StringFormat=\{0:F1\}, TargetNullValue='—'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#424242" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFever}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Время алко. -->
                <DataGridTextColumn
                    Width="115"
                    Binding="{Binding AlcotestTime, StringFormat=\{0:HH:mm:ss\}}"
                    Header="Время алко."
                    IsReadOnly="True"
                    SortMemberPath="AlcotestTime" />

                <!-- Результат алко. (со статусным бейджем) -->
                <DataGridTemplateColumn Width="95" Header="Алкотест" SortMemberPath="AlcotestResult">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAlcotestViolation}" Value="True">
                                                <Setter Property="Background" Value="#FFCDD2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAlcotestViolation}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Kind" Value="AlertOctagon" />
                                                        <Setter Property="Foreground" Value="#B71C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding AlcotestResult, StringFormat=\{0:F2\} ‰, TargetNullValue='—'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAlcotestViolation}" Value="True">
                                                        <Setter Property="Foreground" Value="#B71C1C" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ФИО -->
                <DataGridTextColumn
                    Width="SizeToCells"
                    MinWidth="200"
                    Binding="{Binding FullName}"
                    Header="ФИО"
                    IsReadOnly="True"
                    SortMemberPath="FullName">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Должность -->
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding Position}"
                    Header="Должность"
                    IsReadOnly="True"
                    SortMemberPath="Position" />

                <!-- Подразделение -->
                <DataGridTextColumn
                    Width="170"
                    Binding="{Binding Department}"
                    Header="Подразделение"
                    IsReadOnly="True"
                    SortMemberPath="Department" />

                <!-- Таб. № -->
                <DataGridTextColumn
                    Width="75"
                    Binding="{Binding EmployeeNumber}"
                    Header="Таб. №"
                    IsReadOnly="True"
                    SortMemberPath="EmployeeNumber" />

                <!-- Пропуск -->
                <DataGridTextColumn
                    Width="85"
                    Binding="{Binding PassNumber}"
                    Header="Пропуск"
                    IsReadOnly="True"
                    SortMemberPath="PassNumber" />

                <!-- Системный статус -->
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding SystemNote}"
                    Header="Системный статус"
                    IsReadOnly="True" />

                <!-- Примечание -->
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                    Header="Примечание" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Empty State для журнала логов -->
        <Grid
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding ShowLogsEmptyState, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon
                    Width="56"
                    Height="56"
                    HorizontalAlignment="Center"
                    Foreground="#BDBDBD"
                    Kind="FileSearchOutline" />
                <TextBlock
                    Margin="0,14,0,4"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#757575"
                    Text="Записей не найдено" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#9E9E9E"
                    Text="Попробуйте изменить параметры периода или сбросить фильтры" />
                <Button
                    Margin="0,14,0,0"
                    HorizontalAlignment="Center"
                    Command="{Binding ResetFiltersCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Content="Сбросить фильтры" />
            </StackPanel>
        </Grid>

        <views:DashboardView Grid.Row="1" Visibility="{Binding IsDashboardView, Converter={StaticResource BoolToVis}}" />
        <StatusBar
            Grid.Row="2"
            Padding="10,4"
            materialDesign:ElevationAssist.Elevation="Dp1"
            Background="{DynamicResource MaterialDesignPaper}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!--  Левая часть: Статус  -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <!--  Правая часть: Счетчики  -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!--  1. Сообщение о статусе  -->
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Kind="InformationOutline"
                        Opacity="0.7" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.85"
                        Text="{Binding StatusMessage}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Center" Visibility="{Binding IsDashboardView, Converter={StaticResource InverseBoolToVis}}">
                <Button
                    Command="{Binding SaveChangesCommand}"
                    Content="💾 Сохранить изменения"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" HorizontalAlignment="Center" Visibility="{Binding IsDashboardView, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!--  Кнопка Назад  -->
                    <Button
                        Width="30"
                        Height="30"
                        Padding="0"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </Button>

                    <!--  Индикатор страниц  -->
                    <TextBlock Margin="15,0" VerticalAlignment="Center">
                        <Run Text="Стр. " />
                        <Run FontWeight="SemiBold" Text="{Binding CurrentPage}" />
                        <Run Text=" из " />
                        <Run Text="{Binding TotalPages}" />
                    </TextBlock>

                    <!--  Кнопка Вперед  -->
                    <Button
                        Width="30"
                        Height="30"
                        Padding="0"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </Button>
                </StackPanel>
            </StatusBarItem>

            <!--  2. Информация о количестве записей  -->
            <StatusBarItem Grid.Column="3">
                <StackPanel Orientation="Horizontal">
                    <!--  Отображается, если применен фильтр  -->
                    <StackPanel Margin="0,0,15,0" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="FilterCheck"
                            Opacity="0.7" />
                        <TextBlock Opacity="0.7" Text="Показано: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FilteredCount}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,15,0"
                        Opacity="0.3"
                        Text="|" />

                    <!--  Всего записей  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Database"
                            Opacity="0.7" />
                        <TextBlock Opacity="0.7" Text="Всего в базе: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding TotalCount}" />
                    </StackPanel>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>