<Window
    x:Class="LogGate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LogGate.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LogGate"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Учет времени — Сводка"
    Width="1200"
    Height="600"
    Background="#F5F6F8"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d" Closed="Window_Closed">
    <Window.Resources>
        <converters:AnomalyColorConverter x:Key="AnomalyColorConverter" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,0,0,10"
            Padding="12,8"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8">

            <WrapPanel VerticalAlignment="Center">
                <Button
                    Width="50"
                    Height="50"
                    Margin="0,0,10,0"
                    Command="{Binding LoadDataCommand}"
                    Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                    ToolTip="Загрузить лог-файл CSV">

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            VerticalAlignment="Center"
                            Kind="FolderUpload" />
                    </StackPanel>
                </Button>
                <TextBox
                    Width="250"
                    Height="50"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="Поиск по ФИО, пропуску..."
                    materialDesign:TextFieldAssist.HasClearButton="True"
                    materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Width="150"
                    Height="50"
                    Margin="0,0,10,0"
                    materialDesign:HintAssist.Hint="Выбор периода"
                    ItemsSource="{Binding DatePresets}"
                    SelectedItem="{Binding SelectedDatePreset}"
                    Style="{StaticResource MaterialDesignOutlinedComboBox}" />
                <DatePicker
                    Width="140"
                    Height="50"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="С даты"
                    SelectedDate="{Binding StartDate}"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                <!--  Фильтр по дате "По"  -->
                <DatePicker
                    Width="140"
                    Height="50"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="По дату"
                    SelectedDate="{Binding EndDate}"
                    Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                <!--  Кнопка сброса фильтров  -->
                <Button
                    Height="50"
                    VerticalAlignment="Center"
                    Command="{Binding ResetFiltersCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    ToolTip="Сбросить все фильтры">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Kind="FilterRemove" />
                        <TextBlock VerticalAlignment="Center" Text="Сброс" />
                    </StackPanel>
                </Button>
                <CheckBox
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    Content="Опоздавшие"
                    Cursor="Hand"
                    IsChecked="{Binding ShowLateArrivals}" />
                <CheckBox
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    Content="Ушли рано"
                    Cursor="Hand"
                    IsChecked="{Binding ShowEarlyDepartures}" />

                <!--  По желанию можно настроить внешний вид элементов (ItemTemplate)  -->
            </WrapPanel>
        </Border>
        <DataGrid
            Grid.Row="1"
            AlternatingRowBackground="#FFF0F0F0"
            AutoGenerateColumns="False"
            HeadersVisibility="All"
            IsReadOnly="True"
            ItemsSource="{Binding DataItems}"
            RowHeight="33">

            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                    <Setter Property="Background" Value="{Binding Converter={StaticResource AnomalyColorConverter}}" />
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EventTime, StringFormat=\{0:dd.MM.yy\}}"
                    Header="Дата" />
                <DataGridTextColumn
    Width="SizeToCells"
    Binding="{Binding EventTime, StringFormat=\{0:HH:mm:ss\}}"
    Header="Время">
                    <DataGridTextColumn.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <!-- Теперь красим всю ячейку целиком -->
                            <Setter Property="Background" Value="{Binding Converter={StaticResource AnomalyColorConverter}, ConverterParameter=Time}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                    <DataGridTextColumn.ElementStyle>
                        <!-- Оставляем выравнивание текста по центру -->
                        <Style TargetType="TextBlock">
                            <Setter Property="Padding" Value="5,2" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding Direction}"
                    Header="Вх./выход" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding TemperatureTime, StringFormat=\{0:HH:mm:ss\}}"
                    Header="Время 🌡️" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding Temperature}"
                    Header="🌡️ °C">
                    <DataGridTextColumn.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="Background" Value="{Binding Converter={StaticResource AnomalyColorConverter}, ConverterParameter=Temp}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding AlcotestTime, StringFormat=\{0:dd.MM.yy HH:mm:ss\}}"
                    Header="Время алко." />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding AlcotestResult}"
                    Header="Результат алко.">
                    <DataGridTextColumn.CellStyle>
                        <Style BasedOn="{StaticResource MaterialDesignDataGridCell}" TargetType="DataGridCell">
                            <Setter Property="Background" Value="{Binding Converter={StaticResource AnomalyColorConverter}, ConverterParameter=Alco}" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding FullName}"
                    Header="ФИО" />
                <DataGridTextColumn
                    Width="200"
                    Binding="{Binding Position}"
                    Header="Должность" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Department}"
                    Header="Подразделение" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EmployeeNumber}"
                    Header="Таб. №" />
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding PassNumber}"
                    Header="Пропуск" />
            </DataGrid.Columns>
        </DataGrid>
        <StatusBar
            Grid.Row="2"
            Padding="10,4"
            materialDesign:ElevationAssist.Elevation="Dp1"
            Background="{DynamicResource MaterialDesignPaper}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!--  Левая часть: Статус  -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <!--  Правая часть: Счетчики  -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!--  1. Сообщение о статусе  -->
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Kind="InformationOutline"
                        Opacity="0.7" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.85"
                        Text="{Binding StatusMessage}" />
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem Grid.Column="1" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- Кнопка Назад -->
                    <Button
            Command="{Binding PreviousPageCommand}"
            Style="{StaticResource MaterialDesignToolButton}"
            Width="30" Height="30" Padding="0">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </Button>

                    <!-- Индикатор страниц -->
                    <TextBlock VerticalAlignment="Center" Margin="15,0">
            <Run Text="Стр. " />
            <Run Text="{Binding CurrentPage}" FontWeight="SemiBold" />
            <Run Text=" из " />
            <Run Text="{Binding TotalPages}" />
                    </TextBlock>

                    <!-- Кнопка Вперед -->
                    <Button
            Command="{Binding NextPageCommand}"
            Style="{StaticResource MaterialDesignToolButton}"
            Width="30" Height="30" Padding="0">
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </Button>
                </StackPanel>
            </StatusBarItem>

            <!--  2. Информация о количестве записей  -->
            <StatusBarItem Grid.Column="2">
                <StackPanel Orientation="Horizontal">
                    <!--  Отображается, если применен фильтр  -->
                    <StackPanel Margin="0,0,15,0" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="FilterCheck"
                            Opacity="0.7" />
                        <TextBlock Opacity="0.7" Text="Показано: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FilteredCount}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,15,0"
                        Opacity="0.3"
                        Text="|" />

                    <!--  Всего записей  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Database"
                            Opacity="0.7" />
                        <TextBlock Opacity="0.7" Text="Всего в базе: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding TotalCount}" />
                    </StackPanel>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>