<Window
    x:Class="LogGate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LogGate.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LogGate"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:LogGate.Views"
    Title="Учет времени — Сводка"
    Width="1200"
    Height="600"
    Background="#F5F6F8"
    Closed="Window_Closed"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:AnomalyColorConverter x:Key="AnomalyColorConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <converters:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Margin="0,0,0,10"
            Padding="12,8"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <!--  Отступ между уровнями  -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  1 УРОВЕНЬ: Переключатель экранов, Поиск и Действия  -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Переключатель: Журнал / Дашборд -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                        <RadioButton
                            Style="{StaticResource MaterialDesignTabRadioButton}"
                            Margin="0,0,4,0"
                            IsChecked="{Binding IsDashboardView, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                            Command="{Binding SwitchToLogsViewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TableLarge" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Журнал" VerticalAlignment="Center" FontWeight="Medium" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton
                            Style="{StaticResource MaterialDesignTabRadioButton}"
                            IsChecked="{Binding IsDashboardView, Mode=TwoWay}"
                            Command="{Binding SwitchToDashboardViewCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ViewDashboardOutline" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Дашборд" VerticalAlignment="Center" FontWeight="Medium" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Width="320"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        materialDesign:HintAssist.Hint="Поиск по ФИО, пропуску..."
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding GenerateAiReportCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="Brain" />
                                <TextBlock VerticalAlignment="Center" Text="Анализ ИИ" />
                            </StackPanel>
                        </Button>

                        <Button
                            Margin="0,0,10,0"
                            Command="{Binding OpenScheduleSettingsCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="ChartBox" />
                                <TextBlock VerticalAlignment="Center" Text="Расписание" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding LoadDataCommand}" Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="FileUpload" />
                                <TextBlock VerticalAlignment="Center" Text="Загрузить CSV" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  2 УРОВЕНЬ: Фильтры  -->
                <StackPanel
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ComboBox
                        Width="140"
                        Margin="0,0,15,0"
                        materialDesign:HintAssist.Hint="Период"
                        ItemsSource="{Binding DatePresets}"
                        SelectedItem="{Binding SelectedDatePreset}"
                        Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                    <DatePicker
                        Width="130"
                        Margin="0,0,10,0"
                        materialDesign:HintAssist.Hint="С даты"
                        SelectedDate="{Binding StartDate}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                    <DatePicker
                        Width="130"
                        Margin="0,0,20,0"
                        materialDesign:HintAssist.Hint="По дату"
                        SelectedDate="{Binding EndDate}"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}" />

                    <CheckBox
                        Margin="0,0,10,0"
                        Content="Опоздавшие"
                        IsChecked="{Binding ShowLateArrivals}"
                        Style="{StaticResource MaterialDesignFilterChipOutlineCheckBox}"
                        ToolTip="Показать только опоздавших сотрудников" />

                    <CheckBox
                        Margin="0,0,10,0"
                        Content="Ушли рано"
                        IsChecked="{Binding ShowEarlyDepartures}"
                        Style="{StaticResource MaterialDesignFilterChipOutlineCheckBox}"
                        ToolTip="Показать тех, кто ушел раньше времени" />

                    <CheckBox
                        Margin="0,0,20,0"
                        Content="Не пройден алкотест"
                        IsChecked="{Binding ShowMissingAlcotest}"
                        Style="{StaticResource MaterialDesignFilterChipOutlineCheckBox}"
                        ToolTip="Показать тех, Кто не прошел алкотест" />

                    <Button Command="{Binding ResetFiltersCommand}" Style="{StaticResource MaterialDesignFlatButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="FilterRemove" />
                            <TextBlock VerticalAlignment="Center" Text="Сброс" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid
            x:Name="LogsDataGrid"
            Grid.Row="1"
            AlternatingRowBackground="#FAFAFA"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            HeadersVisibility="All"
            IsReadOnly="False"
            ItemsSource="{Binding DataItems}"
            RowHeight="36"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
            Sorting="LogsDataGrid_Sorting"
            EnableColumnVirtualization="True"
            EnableRowVirtualization="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            ScrollViewer.CanContentScroll="True"
            Visibility="{Binding IsDashboardView, Converter={StaticResource InverseBoolToVis}}">

            <DataGrid.InputBindings>
                <MouseBinding Command="{Binding OpenEmployeeCardCommand}" Gesture="LeftDoubleClick" />
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <!-- Дата -->
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EventTime, StringFormat=\{0:dd.MM.yy\}}"
                    Header="Дата"
                    IsReadOnly="True"
                    SortMemberPath="EventTime" />

                <!-- Время (со статусным бейджем опоздания / раннего ухода) -->
                <DataGridTemplateColumn Width="95" Header="Время" SortMemberPath="EventTime">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                <Setter Property="Background" Value="#FFF3E0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEarlyDeparture}" Value="True">
                                                <Setter Property="Background" Value="#FFEBEE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,3,0"
                                        VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Kind" Value="ClockAlertOutline" />
                                                        <Setter Property="Foreground" Value="#E65100" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEarlyDeparture}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Kind" Value="RunFast" />
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding EventTime, StringFormat=\{0:HH:mm:ss\}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#212121" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLate}" Value="True">
                                                        <Setter Property="Foreground" Value="#E65100" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsEarlyDeparture}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Вход / Выход (стильный чип с иконкой) -->
                <DataGridTemplateColumn Width="90" Header="Вх./Вых." SortMemberPath="Direction">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Padding="6,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#ECEFF1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Direction}" Value="Вход">
                                                <Setter Property="Background" Value="#E8F5E9" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Direction}" Value="Выход">
                                                <Setter Property="Background" Value="#EDE7F6" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,3,0"
                                        VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Kind" Value="ArrowRight" />
                                                <Setter Property="Foreground" Value="#546E7A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="Вход">
                                                        <Setter Property="Kind" Value="Login" />
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="Выход">
                                                        <Setter Property="Kind" Value="Logout" />
                                                        <Setter Property="Foreground" Value="#5E35B1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Direction}" />
                                                <Setter Property="Foreground" Value="#546E7A" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Direction}" Value="Вход">
                                                        <Setter Property="Foreground" Value="#2E7D32" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Direction}" Value="Выход">
                                                        <Setter Property="Foreground" Value="#5E35B1" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Время 🌡️ -->
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding TemperatureTime, StringFormat=\{0:HH:mm:ss\}}"
                    Header="Время 🌡️"
                    IsReadOnly="True"
                    SortMemberPath="TemperatureTime" />

                <!-- Температура (со статусным бейджем) -->
                <DataGridTemplateColumn Width="85" Header="🌡️ °C" SortMemberPath="Temperature">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFever}" Value="True">
                                                <Setter Property="Background" Value="#FFEBEE" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFever}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Kind" Value="ThermometerAlert" />
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding Temperature, StringFormat=\{0:F1\}, TargetNullValue='—'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#424242" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasFever}" Value="True">
                                                        <Setter Property="Foreground" Value="#C62828" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Время алко. -->
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding AlcotestTime, StringFormat=\{0:dd.MM.yy HH:mm:ss\}}"
                    Header="Время алко."
                    IsReadOnly="True"
                    SortMemberPath="AlcotestTime" />

                <!-- Результат алко. (со статусным бейджем) -->
                <DataGridTemplateColumn Width="95" Header="Алкотест" SortMemberPath="AlcotestResult">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAlcotestViolation}" Value="True">
                                                <Setter Property="Background" Value="#FFCDD2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,2,0"
                                        VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAlcotestViolation}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="Kind" Value="AlertOctagon" />
                                                        <Setter Property="Foreground" Value="#B71C1C" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Text="{Binding AlcotestResult, StringFormat=\{0:F2\} ‰, TargetNullValue='—'}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAlcotestViolation}" Value="True">
                                                        <Setter Property="Foreground" Value="#B71C1C" />
                                                        <Setter Property="FontWeight" Value="Bold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ФИО -->
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding FullName}"
                    Header="ФИО"
                    IsReadOnly="True"
                    SortMemberPath="FullName">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Medium" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Padding" Value="4,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Должность -->
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding Position}"
                    Header="Должность"
                    IsReadOnly="True"
                    SortMemberPath="Position" />

                <!-- Подразделение -->
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding Department}"
                    Header="Подразделение"
                    IsReadOnly="True"
                    SortMemberPath="Department" />

                <!-- Таб. № -->
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding EmployeeNumber}"
                    Header="Таб. №"
                    IsReadOnly="True"
                    SortMemberPath="EmployeeNumber" />

                <!-- Пропуск -->
                <DataGridTextColumn
                    Width="SizeToCells"
                    Binding="{Binding PassNumber}"
                    Header="Пропуск"
                    IsReadOnly="True"
                    SortMemberPath="PassNumber" />

                <!-- Системный статус -->
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding SystemNote}"
                    Header="Системный статус"
                    IsReadOnly="True" />

                <!-- Примечание -->
                <DataGridTextColumn
                    Width="Auto"
                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                    Header="Примечание" />
            </DataGrid.Columns>
        </DataGrid>
        <views:DashboardView Grid.Row="1" Visibility="{Binding IsDashboardView, Converter={StaticResource BoolToVis}}" />
        <StatusBar
            Grid.Row="2"
            Padding="10,4"
            materialDesign:ElevationAssist.Elevation="Dp1"
            Background="{DynamicResource MaterialDesignPaper}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!--  Левая часть: Статус  -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <!--  Правая часть: Счетчики  -->
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!--  1. Сообщение о статусе  -->
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Kind="InformationOutline"
                        Opacity="0.7" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.85"
                        Text="{Binding StatusMessage}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Center" Visibility="{Binding IsDashboardView, Converter={StaticResource InverseBoolToVis}}">
                <Button
                    Command="{Binding SaveChangesCommand}"
                    Content="💾 Сохранить изменения"
                    Style="{StaticResource MaterialDesignOutlinedButton}" />
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" HorizontalAlignment="Center" Visibility="{Binding IsDashboardView, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <!--  Кнопка Назад  -->
                    <Button
                        Width="30"
                        Height="30"
                        Padding="0"
                        Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="ChevronLeft" />
                    </Button>

                    <!--  Индикатор страниц  -->
                    <TextBlock Margin="15,0" VerticalAlignment="Center">
                        <Run Text="Стр. " />
                        <Run FontWeight="SemiBold" Text="{Binding CurrentPage}" />
                        <Run Text=" из " />
                        <Run Text="{Binding TotalPages}" />
                    </TextBlock>

                    <!--  Кнопка Вперед  -->
                    <Button
                        Width="30"
                        Height="30"
                        Padding="0"
                        Command="{Binding NextPageCommand}"
                        Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="ChevronRight" />
                    </Button>
                </StackPanel>
            </StatusBarItem>

            <!--  2. Информация о количестве записей  -->
            <StatusBarItem Grid.Column="3">
                <StackPanel Orientation="Horizontal">
                    <!--  Отображается, если применен фильтр  -->
                    <StackPanel Margin="0,0,15,0" Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="FilterCheck"
                            Opacity="0.7" />
                        <TextBlock Opacity="0.7" Text="Показано: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding FilteredCount}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,15,0"
                        Opacity="0.3"
                        Text="|" />

                    <!--  Всего записей  -->
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="Database"
                            Opacity="0.7" />
                        <TextBlock Opacity="0.7" Text="Всего в базе: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding TotalCount}" />
                    </StackPanel>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>