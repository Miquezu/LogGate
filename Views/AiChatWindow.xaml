<Window
    x:Class="LogGate.Views.AiChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Интерактивный AI-Аналитик"
    Width="800"
    Height="650"
    Background="#F5F6F8"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!--  Автономный стиль для выравнивания и цвета пузырей сообщений  -->
        <Style x:Key="BubbleStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#E0E0E0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Цвет текста заголовка (Вы/ИИ)  -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Black" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Foreground" Value="Black" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Цвет текста Markdown  -->
        <Style x:Key="MarkdownStyle" TargetType="markdig:MarkdownViewer">
            <Setter Property="Foreground" Value="Black" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Foreground" Value="Black" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,15"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8">
            <ScrollViewer
                x:Name="ChatScrollViewer"
                Padding="15"
                PreviewMouseWheel="ChatScrollViewer_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,15">
                                <Border
                                    MaxWidth="600"
                                    Padding="12,8"
                                    CornerRadius="12"
                                    Style="{StaticResource BubbleStyle}">
                                    <StackPanel>
                                        <TextBlock
                                            Margin="0,0,0,4"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Opacity="0.7"
                                            Style="{StaticResource TitleTextStyle}"
                                            Text="{Binding SenderName}" />
                                        <markdig:MarkdownViewer
                                            Margin="0"
                                            Markdown="{Binding Text}"
                                            Style="{StaticResource MarkdownStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                MaxHeight="100"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="Задайте вопрос по данным..."
                AcceptsReturn="True"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap">
                <TextBox.InputBindings>
                    <KeyBinding
                        Key="Enter"
                        Command="{Binding SendMessageCommand}"
                        Modifiers="Ctrl" />
                </TextBox.InputBindings>
            </TextBox>

            <Grid
                Grid.Column="1"
                Margin="15,0,0,0"
                VerticalAlignment="Center">
                <Button
                    Width="50"
                    Height="50"
                    Command="{Binding SendMessageCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignFloatingActionMiniButton}" TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon
                        Width="24"
                        Height="24"
                        Kind="Send" />
                </Button>

                <ProgressBar
                    Width="40"
                    Height="40"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>