<Window
    x:Class="LogGate.Views.AiChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Интерактивный AI-Аналитик"
    Width="900"
    Height="700"
    MinWidth="750"
    MinHeight="550"
    Icon="/Assets/app_icon.ico"
    Background="#F5F6F8"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Автономный стиль для выравнивания и цвета пузырей сообщений -->
        <Style x:Key="BubbleStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Background" Value="#E8EAF6" />
                    <Setter Property="BorderBrush" Value="#C5CAE9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Цвет текста заголовка (Вы/ИИ) -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5E35B1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="Foreground" Value="#1565C0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Цвет текста Markdown -->
        <Style x:Key="MarkdownStyle" TargetType="markdig:MarkdownViewer">
            <Setter Property="Foreground" Value="#212121" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0: Список сообщений -->
            <RowDefinition Height="*" />
            <!-- 1: Быстрые подсказки-вопросы -->
            <RowDefinition Height="Auto" />
            <!-- 2: Поле ввода и кнопки -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. ЧАТ И СООБЩЕНИЯ -->
        <materialDesign:Card
            Grid.Row="0"
            Margin="0,0,0,12"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="{DynamicResource MaterialDesignPaper}"
            UniformCornerRadius="10">
            <ScrollViewer
                x:Name="ChatScrollViewer"
                Padding="16"
                PreviewMouseWheel="ChatScrollViewer_PreviewMouseWheel">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,16">
                                <Border
                                    MaxWidth="680"
                                    Padding="14,10"
                                    CornerRadius="12"
                                    materialDesign:ElevationAssist.Elevation="Dp1"
                                    Style="{StaticResource BubbleStyle}">
                                    <StackPanel>
                                        <!-- Шапка сообщения: Иконка + Имя отправителя -->
                                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                            <!-- Иконка робота для ИИ -->
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="#5E35B1">
                                                <materialDesign:PackIcon.Style>
                                                    <Style TargetType="materialDesign:PackIcon">
                                                        <Setter Property="Kind" Value="RobotOutline" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                <Setter Property="Kind" Value="AccountCircleOutline" />
                                                                <Setter Property="Foreground" Value="#1565C0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </materialDesign:PackIcon.Style>
                                            </materialDesign:PackIcon>

                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Style="{StaticResource TitleTextStyle}"
                                                Text="{Binding SenderName}" />
                                        </StackPanel>

                                        <!-- Содержимое Markdown -->
                                        <markdig:MarkdownViewer
                                            Margin="0"
                                            Markdown="{Binding Text}"
                                            Style="{StaticResource MarkdownStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </materialDesign:Card>

        <!-- 1. БЫСТРЫЕ ПОДСКАЗКИ / ПРОМПТЫ -->
        <ScrollViewer
            Grid.Row="1"
            Margin="0,0,0,10"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Height="32"
                            Margin="0,0,8,0"
                            Padding="12,4"
                            Command="{Binding DataContext.ApplySuggestionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="Нажмите, чтобы отправить этот запрос">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="#FB8C00"
                                    Kind="LightbulbOutline" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Text="{Binding}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 2. СТРОКА ВВОДА И КНОПКИ ДЕЙСТВИЯ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                Grid.Column="0"
                MaxHeight="100"
                VerticalAlignment="Center"
                materialDesign:HintAssist.Hint="Задайте вопрос по данным... (или нажмите на подсказку выше)"
                AcceptsReturn="True"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap">
                <TextBox.InputBindings>
                    <KeyBinding
                        Key="Enter"
                        Command="{Binding SendMessageCommand}"
                        Modifiers="Ctrl" />
                </TextBox.InputBindings>
            </TextBox>

            <Grid
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Center">

                <!-- Кнопка отправки (видима, когда система свободна) -->
                <Button
                    Width="48"
                    Height="48"
                    Command="{Binding SendMessageCommand}"
                    ToolTip="Отправить (Ctrl+Enter)">
                    <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignFloatingActionMiniButton}" TargetType="Button">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <materialDesign:PackIcon
                        Width="22"
                        Height="22"
                        Kind="Send" />
                </Button>

                <!-- Кнопка остановки генерации и спиннер (видимы во время работы) -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button
                        Width="48"
                        Height="48"
                        Background="#E53935"
                        BorderBrush="#E53935"
                        Command="{Binding CancelGenerationCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        ToolTip="Остановить генерацию">
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Kind="Stop" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>