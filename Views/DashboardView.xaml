<UserControl
    x:Class="LogGate.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,0,15">
            <!-- 1. ВЕРХНИЙ РЯД: KPI КАРТОЧКИ -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Карточка: Уникальных сотрудников -->
                <materialDesign:Card
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="14,12"
                    materialDesign:ElevationAssist.Elevation="Dp2"
                    Background="{DynamicResource MaterialDesignPaper}"
                    Cursor="Hand"
                    ToolTip="Нажмите для перехода к общему списку в журнале"
                    UniformCornerRadius="8">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding Command="{Binding DrillDownAllCommand}" Gesture="LeftClick" />
                    </materialDesign:Card.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Сотрудников" FontSize="12" Foreground="#757575" FontWeight="Medium" />
                            <TextBlock Text="{Binding KpiUniqueEmployees}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="#1E88E5" />
                            <TextBlock Text="на территории" FontSize="11" Foreground="#9E9E9E" />
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1" Kind="AccountGroup" Width="36" Height="36" Foreground="#90CAF9" VerticalAlignment="Center" />
                    </Grid>
                </materialDesign:Card>

                <!-- Карточка: Всего проходов -->
                <materialDesign:Card
                    Grid.Column="1"
                    Margin="4,0,4,0"
                    Padding="14,12"
                    materialDesign:ElevationAssist.Elevation="Dp2"
                    Background="{DynamicResource MaterialDesignPaper}"
                    Cursor="Hand"
                    ToolTip="Нажмите для перехода ко всем записям журнала"
                    UniformCornerRadius="8">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding Command="{Binding DrillDownAllCommand}" Gesture="LeftClick" />
                    </materialDesign:Card.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Всего проходов" FontSize="12" Foreground="#757575" FontWeight="Medium" />
                            <TextBlock Text="{Binding KpiTotalPasses}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="#5E35B1" />
                            <TextBlock Text="входы и выходы" FontSize="11" Foreground="#9E9E9E" />
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1" Kind="DoorOpen" Width="36" Height="36" Foreground="#B39DDB" VerticalAlignment="Center" />
                    </Grid>
                </materialDesign:Card>

                <!-- Карточка: Опоздания -->
                <materialDesign:Card
                    Grid.Column="2"
                    Margin="4,0,4,0"
                    Padding="14,12"
                    materialDesign:ElevationAssist.Elevation="Dp2"
                    Background="{DynamicResource MaterialDesignPaper}"
                    Cursor="Hand"
                    ToolTip="Нажмите для фильтрации опоздавших в журнале"
                    UniformCornerRadius="8">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding Command="{Binding DrillDownLateCommand}" Gesture="LeftClick" />
                    </materialDesign:Card.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Опозданий" FontSize="12" Foreground="#757575" FontWeight="Medium" />
                            <TextBlock Text="{Binding KpiLateCount}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="#FB8C00" />
                            <TextBlock Text="{Binding KpiLatePercentage, StringFormat='{}Доля: {0}'}" FontSize="11" Foreground="#FFA726" />
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1" Kind="ClockAlertOutline" Width="36" Height="36" Foreground="#FFCC80" VerticalAlignment="Center" />
                    </Grid>
                </materialDesign:Card>

                <!-- Карточка: Ранние уходы -->
                <materialDesign:Card
                    Grid.Column="3"
                    Margin="4,0,4,0"
                    Padding="14,12"
                    materialDesign:ElevationAssist.Elevation="Dp2"
                    Background="{DynamicResource MaterialDesignPaper}"
                    Cursor="Hand"
                    ToolTip="Нажмите для фильтрации ушедших раньше времени в журнале"
                    UniformCornerRadius="8">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding Command="{Binding DrillDownEarlyCommand}" Gesture="LeftClick" />
                    </materialDesign:Card.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Ранних уходов" FontSize="12" Foreground="#757575" FontWeight="Medium" />
                            <TextBlock Text="{Binding KpiEarlyCount}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="#F4511E" />
                            <TextBlock Text="{Binding KpiEarlyPercentage, StringFormat='{}Доля: {0}'}" FontSize="11" Foreground="#FF8A65" />
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1" Kind="RunFast" Width="36" Height="36" Foreground="#FFAB91" VerticalAlignment="Center" />
                    </Grid>
                </materialDesign:Card>

                <!-- Карточка: Критические инциденты -->
                <materialDesign:Card
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    Padding="14,12"
                    materialDesign:ElevationAssist.Elevation="Dp2"
                    Background="{DynamicResource MaterialDesignPaper}"
                    Cursor="Hand"
                    ToolTip="Нажмите для фильтрации непройденных алкотестов в журнале"
                    UniformCornerRadius="8">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding Command="{Binding DrillDownCriticalCommand}" Gesture="LeftClick" />
                    </materialDesign:Card.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Инциденты (СБ/Мед)" FontSize="12" Foreground="#757575" FontWeight="Medium" />
                            <TextBlock Text="{Binding KpiCriticalCount}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0" Foreground="#E53935" />
                            <TextBlock Text="алкотест / темп. > 37.2" FontSize="11" Foreground="#E57373" />
                        </StackPanel>
                        <materialDesign:PackIcon Grid.Column="1" Kind="AlertDecagram" Width="36" Height="36" Foreground="#EF9A9A" VerticalAlignment="Center" />
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- 2. СРЕДНИЙ РЯД: ПОЧАСОВОЙ ТРАФИК И КРУГОВАЯ ДИАГРАММА НАРУШЕНИЙ -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- График: Трафик проходной по часам -->
                <materialDesign:Card Grid.Column="0" Margin="0,0,8,0" Padding="16" UniformCornerRadius="8" Background="{DynamicResource MaterialDesignPaper}" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="ChartBar" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#1976D2" />
                            <TextBlock Text="Загрузка проходных по часам суток (Входы / Выходы)" FontWeight="Bold" FontSize="14" Foreground="#333333" VerticalAlignment="Center" />
                        </StackPanel>
                        <lvc:CartesianChart Series="{Binding HourlyTrafficSeries}" XAxes="{Binding HourlyXAxes}" Height="280" LegendPosition="Top" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- График: Структура нарушений -->
                <materialDesign:Card Grid.Column="1" Margin="8,0,0,0" Padding="16" UniformCornerRadius="8" Background="{DynamicResource MaterialDesignPaper}" materialDesign:ElevationAssist.Elevation="Dp2">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="ChartPie" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#9C27B0" />
                            <TextBlock Text="Структура нарушений" FontWeight="Bold" FontSize="14" Foreground="#333333" VerticalAlignment="Center" />
                        </StackPanel>
                        <lvc:PieChart Series="{Binding ViolationsPieSeries}" Height="280" LegendPosition="Right" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>

            <!-- 3. НИЖНИЙ РЯД: ТОП-5 ОТДЕЛОВ ПО НАРУШЕНИЯМ -->
            <materialDesign:Card Padding="16" UniformCornerRadius="8" Background="{DynamicResource MaterialDesignPaper}" materialDesign:ElevationAssist.Elevation="Dp2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="AccountMultipleRemoveOutline" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#E53935" />
                        <TextBlock Text="Подразделения с наибольшим числом нарушений (Топ-5)" FontWeight="Bold" FontSize="14" Foreground="#333333" VerticalAlignment="Center" />
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding DepartmentSeries}" YAxes="{Binding DepartmentYAxes}" Height="220" />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
