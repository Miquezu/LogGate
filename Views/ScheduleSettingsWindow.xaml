<Window
    x:Class="LogGate.Views.ScheduleSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:LogGate.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Настройки графиков работы"
    Width="700"
    Height="500"
    Background="#F5F6F8"
    Style="{StaticResource MaterialDesignWindow}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:BooleanToTextConverter x:Key="BooleanToTextConverter" />
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,0,0,15"
            Padding="5"
            materialDesign:ElevationAssist.Elevation="Dp2"
            Background="{DynamicResource MaterialDesignPaper}"
            CornerRadius="8">
            <StackPanel>
                <WrapPanel VerticalAlignment="Bottom">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock
                            Margin="0,0,0,4"
                            FontSize="10"
                            Opacity="0.6"
                            Text="Тип графика:" />
                        <ToggleButton
                            IsChecked="{Binding NewIsPersonal}"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}"
                            ToolTip="Отключено = Отдел, Включено = Сотрудник" />
                        <TextBlock
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Text="{Binding NewIsPersonal, Converter={StaticResource BooleanToTextConverter}}" />
                    </StackPanel>

                    <TextBox
                        Width="200"
                        Height="50"
                        Margin="0,0,15,0"
                        materialDesign:HintAssist.Hint="Название отдела или ФИО"
                        Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                        Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Margin="0,0,15,0">
                        <materialDesign:TimePicker
                            Width="100"
                            Height="25"
                            Margin="0,0,0,5"
                            materialDesign:HintAssist.Hint="Приход (С)"
                            Is24Hours="True"
                            SelectedTime="{Binding NewStartTime}" />
                        <materialDesign:TimePicker
                            Width="100"
                            Height="25"
                            Margin="0,0,0,0"
                            materialDesign:HintAssist.Hint="Уход (По)"
                            Is24Hours="True"
                            SelectedTime="{Binding NewEndTime}" />
                    </StackPanel>

                    <Button
                        Command="{Binding AddRuleCommand}"
                        Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                        ToolTip="Добавить правило">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Kind="Plus" />
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!--  Таблица существующих правил  -->
        <DataGrid
            Grid.Row="1"
            AlternatingRowBackground="#FFF0F0F0"
            AutoGenerateColumns="False"
            Background="{DynamicResource MaterialDesignPaper}"
            CanUserAddRows="False"
            ItemsSource="{Binding Rules}"
            SelectedItem="{Binding SelectedRule}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn
                    Width="SizeToCells"
                    Binding="{Binding IsPersonal}"
                    Header="Индивидуальный" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding TargetName}"
                    Header="Отдел / ФИО" />
                <DataGridTextColumn
                    Width="SizeToHeader"
                    Binding="{Binding StartTime, StringFormat=\{0:hh\\:mm\}}"
                    Header="Время прихода" />
                <DataGridTextColumn
                    Width="SizeToHeader"
                    Binding="{Binding EndTime, StringFormat=\{0:hh\\:mm\}}"
                    Header="Время ухода" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding DeleteRuleCommand}" Header="Удалить правило">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="TrashCan" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!--  Панель сохранения  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,15,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="200"
                Command="{Binding SaveChangesCommand}"
                Content="Сохранить изменения" />
        </StackPanel>
    </Grid>
</Window>