<Window x:Class="LogGate.Views.ScheduleSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" xmlns:converters="clr-namespace:LogGate.Converters"
        mc:Ignorable="d"
        Title="Настройки графиков работы" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MaterialDesignWindow}"
        Background="#F5F6F8">
    <Window.Resources>
        <converters:BooleanToTextConverter x:Key="BooleanToTextConverter" />
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Форма добавления нового правила -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="8" Padding="15" Margin="0,0,0,15"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel>
                <TextBlock Text="Добавить новый график" FontWeight="Bold" Margin="0,0,0,10" Opacity="0.7" />

                <WrapPanel VerticalAlignment="Bottom">
                    <!-- Переключатель: Отдел или Сотрудник -->
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Тип графика:" FontSize="10" Opacity="0.6" Margin="0,0,0,4" />
                        <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding NewIsPersonal}"
                                      ToolTip="Отключено = Отдел, Включено = Сотрудник" />
                        <TextBlock Text="{Binding NewIsPersonal, Converter={StaticResource BooleanToTextConverter}}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" FontSize="10" />
                    </StackPanel>

                    <TextBox Width="200" Margin="0,0,15,0"
                             materialDesign:HintAssist.Hint="Название отдела или ФИО"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                             Text="{Binding NewTargetName, UpdateSourceTrigger=PropertyChanged}" />

                    <materialDesign:TimePicker Width="100" Margin="0,0,15,0"
                                               materialDesign:HintAssist.Hint="Приход (С)"
                                               Is24Hours="True"
                                               SelectedTime="{Binding NewStartTime}" />

                    <materialDesign:TimePicker Width="100" Margin="0,0,15,0"
                                               materialDesign:HintAssist.Hint="Уход (По)"
                                               Is24Hours="True"
                                               SelectedTime="{Binding NewEndTime}" />

                    <Button Command="{Binding AddRuleCommand}"
                            Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            ToolTip="Добавить правило">
                        <materialDesign:PackIcon Kind="Plus" Width="24" Height="24" />
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Таблица существующих правил -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  AlternatingRowBackground="#FFF0F0F0"
                  Background="{DynamicResource MaterialDesignPaper}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsPersonal}" Header="Индивидуальный" Width="SizeToCells" />
                <DataGridTextColumn Binding="{Binding TargetName}" Header="Отдел / ФИО" Width="*" />
                <DataGridTextColumn Binding="{Binding StartTime, StringFormat=\{0:hh\\:mm\}}" Header="Время прихода" Width="SizeToHeader" />
                <DataGridTextColumn Binding="{Binding EndTime, StringFormat=\{0:hh\\:mm\}}" Header="Время ухода" Width="SizeToHeader" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Удалить правило" Command="{Binding DeleteRuleCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="TrashCan" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Панель сохранения -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Command="{Binding SaveChangesCommand}" Content="Сохранить изменения" Width="200" />
        </StackPanel>
    </Grid>
</Window>